# Porta HTTP da API
PORT=3333

# Interface de rede (vazio = todas). Em produção atrás do Caddy: 127.0.0.1
HOST=

# Proxies confiáveis para descobrir o IP real do visitante (usado no limite de requisições).
# Vazio = nenhum. Com o Caddy na mesma máquina: loopback. Nunca use "true".
TRUST_PROXY=

# Ambiente: development | production | test
NODE_ENV=development

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Município de residência (código IBGE de 6 dígitos, como aparece no SIVEP-Gripe).
# 280350 = Lagarto-SE
MUNICIPIO_IBGE=280350
MUNICIPIO_NOME=Lagarto
MUNICIPIO_UF=SE

# Anos importados. Ex.: "2019-atual" (todos), "2024,2025" ou vazio = ano atual e anterior.
# Atenção: os arquivos nacionais são grandes (2021 tem ~1,8 GB) e são lidos em streaming.
ANOS=

# Com MONGO_URI, os casos ficam no MongoDB. Sem ela, ficam em memória com cache em DATA_DIR.
# Ex.: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=srag_lagarto
# Por quantos segundos a API reaproveita os dados lidos do banco antes de conferir de novo (0 = sem cache)
MONGO_CACHE_SEGUNDOS=60

# A cada quantas horas verificar se o Ministério publicou um arquivo novo (0 = desativado)
SYNC_INTERVALO_HORAS=12

# Sincronizar automaticamente ao iniciar o servidor
SYNC_AO_INICIAR=true

# Pasta onde ficam os dados de Lagarto já filtrados (cache local)
DATA_DIR=./data

# Página do conjunto de dados SRAG no OpenDataSUS (usada para descobrir o arquivo mais recente)
OPENDATASUS_DATASET_URL=https://dadosabertos.saude.gov.br/dataset/srag-2019-a-2026

# Token para POST /v1/admin/sincronizar (vazio = rota desativada). Use um valor longo e aleatório.
ADMIN_TOKEN=

# CORS: "*" ou lista separada por vírgula
CORS_ORIGIN=*

# Limite de requisições por IP por minuto
RATE_LIMIT_POR_MINUTO=120

# --- Observabilidade ---

# /health responde 503 se não houver sincronização bem-sucedida há mais que estas horas (0 = não cobrar).
# Use um valor maior que o intervalo de sincronização para tolerar uma falha passageira do OpenDataSUS.
SAUDE_MAX_HORAS_SEM_SYNC=36

# Healthchecks.io (opcional): URL de ping do check, ex.: https://hc-ping.com/<uuid>
# A API avisa o início, o sucesso e a falha de cada sincronização.
HEALTHCHECKS_URL=

# Sentry (opcional): DSN do projeto. Erros 500 e falhas de sincronização são enviados para lá.
SENTRY_DSN=
